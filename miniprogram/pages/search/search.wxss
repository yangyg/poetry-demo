/* 搜索 Tab 样式 — 宣纸墨韵风格，变量来自 app.wxss */

.page-body {
  /* 底部预留自定义 tabBar 高度 + 安全区 */
  padding: 16rpx 40rpx 200rpx;
}

/* ══════════ 搜索区（对应 Web 端 .search） ══════════ */

.search {
  margin-top: 40rpx;
}

/* 标题（对应 .search h2） */
.search-heading {
  margin-bottom: 32rpx;
  font-family: var(--font-display);
  font-size: 51rpx;
  font-weight: 400;
  letter-spacing: 13rpx;
}

/* 搜索表单（对应 .search-form） */
.search-form {
  display: flex;
  gap: 19rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  border: 2rpx solid var(--line);
  background: var(--input-bg);
  color: var(--ink);
  padding: 22rpx 29rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  border-radius: var(--radius);
}

.search-placeholder {
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}

.search-btn {
  flex-shrink: 0;
}

/* 状态提示（对应 .search-hint） */
.search-hint {
  min-height: 48rpx;
  margin: 24rpx 0 8rpx;
  color: var(--ink-faint);
  font-size: 29rpx;
  letter-spacing: 3rpx;
}

/* 结果列表（对应 .search-results） */
.search-results {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 16rpx;
}

.result-item {
  border: 2rpx solid var(--line);
  background: var(--item-bg);
  padding: 29rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border-radius: var(--radius);
}

/* 按压反馈（对应 Web 端 :hover） */
.result-item-hover {
  border-color: var(--seal-45);
  transform: translateX(4rpx);
}

.result-title {
  font-weight: 600;
  letter-spacing: 3rpx;
  font-size: 30rpx;
}

.result-meta {
  color: var(--ink-faint);
  font-size: 27rpx;
  letter-spacing: 4rpx;
}

.result-excerpt {
  color: var(--ink-soft);
  font-size: 29rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ══════════ 页脚（对应 .site-footer） ══════════ */

.site-footer {
  margin-top: 96rpx;
  padding-bottom: 40rpx;
  color: var(--ink-faint);
  font-size: 27rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
