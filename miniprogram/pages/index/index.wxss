/* 首页样式 — 迁移自 Web 端 src/style.css（宣纸墨韵风格） */

.page-body {
  padding: 16rpx 40rpx 96rpx;
}

/* ══════════ 阅读区（对应 .reader） ══════════ */

.reader {
  margin-top: 40rpx;
  padding: 64rpx 48rpx 48rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  box-shadow: 0 36rpx 80rpx var(--shadow);
  border-radius: var(--radius);
}

.reader-inner {
  min-height: 384rpx;
  text-align: center;
}

/* 加载 / 错误状态（对应 .status） */
.status {
  margin: 96rpx 0;
  color: var(--ink-faint);
  letter-spacing: 6rpx;
  font-size: 30rpx;
}

/* 诗歌切换动画容器 */
.poem-anim {
  animation: fade-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 标题（对应 .poem-title） */
.poem-title {
  margin-bottom: 19rpx;
  font-family: var(--font-display);
  font-size: 64rpx;
  font-weight: 400;
  letter-spacing: 12rpx;
  line-height: 1.4;
}

/* 朝代·作者（对应 .poem-meta） */
.poem-meta {
  margin-bottom: 48rpx;
  color: var(--ink-faint);
  letter-spacing: 6rpx;
  font-size: 30rpx;
}

/* 诗句（对应 .poem-body p） */
.poem-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11rpx;
}

.poem-line {
  font-size: 36rpx;
  letter-spacing: 4rpx;
  color: var(--ink);
  line-height: 1.8;
}

/* 换一首按钮区（对应 .reader-actions） */
.reader-actions {
  display: flex;
  justify-content: center;
  margin-top: 56rpx;
  padding-top: 40rpx;
  border-top: 2rpx dashed var(--line);
}

/* ══════════ 搜索区（对应 .search） ══════════ */

.search {
  margin-top: 80rpx;
}

.anim-delay-2 {
  animation-delay: 0.16s;
}

/* 标题（对应 .search h2） */
.search-heading {
  margin-bottom: 32rpx;
  font-family: var(--font-display);
  font-size: 51rpx;
  font-weight: 400;
  letter-spacing: 13rpx;
}

/* 搜索表单（对应 .search-form） */
.search-form {
  display: flex;
  gap: 19rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  border: 2rpx solid var(--line);
  background: var(--input-bg);
  color: var(--ink);
  padding: 22rpx 29rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  border-radius: var(--radius);
}

.search-placeholder {
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}

.search-btn {
  flex-shrink: 0;
}

/* 状态提示（对应 .search-hint） */
.search-hint {
  min-height: 48rpx;
  margin: 24rpx 0 8rpx;
  color: var(--ink-faint);
  font-size: 29rpx;
  letter-spacing: 3rpx;
}

/* 结果列表（对应 .search-results） */
.search-results {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 16rpx;
}

.result-item {
  border: 2rpx solid var(--line);
  background: var(--item-bg);
  padding: 29rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border-radius: var(--radius);
}

/* 按压反馈（对应 Web 端 :hover） */
.result-item-hover {
  border-color: var(--seal-45);
  transform: translateX(4rpx);
}

.result-title {
  font-weight: 600;
  letter-spacing: 3rpx;
  font-size: 30rpx;
}

.result-meta {
  color: var(--ink-faint);
  font-size: 27rpx;
  letter-spacing: 4rpx;
}

.result-excerpt {
  color: var(--ink-soft);
  font-size: 29rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ══════════ 页脚（对应 .site-footer） ══════════ */

.site-footer {
  margin-top: 96rpx;
  padding-bottom: 40rpx;
  color: var(--ink-faint);
  font-size: 27rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
