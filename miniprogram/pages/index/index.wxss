/* 首页 Tab 样式 — 阅读区（宣纸墨韵风格） */

.page-body {
  /* 底部预留自定义 tabBar 高度 + 安全区 */
  padding: 16rpx 40rpx 200rpx;
}

/* ══════════ 阅读区（对应 .reader） ══════════ */

.reader {
  margin-top: 40rpx;
  padding: 64rpx 48rpx 48rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  box-shadow: 0 36rpx 80rpx var(--shadow);
  border-radius: var(--radius);
}

.reader-inner {
  min-height: 384rpx;
  text-align: center;
}

/* 加载 / 错误状态（对应 .status） */
.status {
  margin: 96rpx 0;
  color: var(--ink-faint);
  letter-spacing: 6rpx;
  font-size: 30rpx;
}

/* 诗歌切换动画容器 */
.poem-anim {
  animation: fade-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 标题（对应 .poem-title） */
.poem-title {
  margin-bottom: 19rpx;
  font-family: var(--font-display);
  font-size: 64rpx;
  font-weight: 400;
  letter-spacing: 12rpx;
  line-height: 1.4;
}

/* 朝代·作者（对应 .poem-meta） */
.poem-meta {
  margin-bottom: 48rpx;
  color: var(--ink-faint);
  letter-spacing: 6rpx;
  font-size: 30rpx;
}

/* 诗句（对应 .poem-body p） */
.poem-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11rpx;
}

.poem-line {
  font-size: 36rpx;
  letter-spacing: 4rpx;
  color: var(--ink);
  line-height: 1.8;
}

/* 换一首按钮区（对应 .reader-actions） */
.reader-actions {
  display: flex;
  justify-content: center;
  margin-top: 56rpx;
  padding-top: 40rpx;
  border-top: 2rpx dashed var(--line);
}

/* ══════════ 页脚（对应 .site-footer） ══════════ */

.site-footer {
  margin-top: 96rpx;
  padding-bottom: 40rpx;
  color: var(--ink-faint);
  font-size: 27rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
