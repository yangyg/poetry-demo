<!-- 首页 Tab：阅读区（随机诗 + 换一首） -->
<custom-nav lang="{{lang}}" bind:langchange="onLangChange" />

<view class="page-body">
  <!-- ═══ 阅读区 ═══ -->
  <view class="reader anim-rise">
    <view class="reader-inner">
      <!-- 加载 / 错误状态 -->
      <view wx:if="{{readerLoading || readerError}}" class="status">
        {{readerError || '正在取诗…'}}
      </view>

      <!-- 诗歌展示 -->
      <block wx:else>
        <view key="{{animKey}}" class="poem-anim">
          <view class="poem-title">{{poem.title || '无题'}}</view>
          <view class="poem-meta">{{poemMeta}}</view>
          <view class="poem-body">
            <text class="poem-line" wx:for="{{poem.content}}" wx:key="index">{{item}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 换一首 -->
    <view class="reader-actions">
      <button
        class="btn-ink {{randomLoading ? 'btn-ink-disabled' : ''}}"
        hover-class="btn-ink-hover"
        disabled="{{randomLoading}}"
        bindtap="onRandom"
      >换一首</button>
    </view>
  </view>

  <!-- ═══ 页脚 ═══ -->
  <view class="site-footer">
    <text>数据来自诗泉 API（poetry.palemoky.com），源自开源项目 chinese-poetry。</text>
  </view>
</view>
