---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<Layout title="诗泉 — 搜索">
  <div class="paper-grain" aria-hidden="true"></div>

  <SiteHeader />

  <main>
    <section class="search" aria-labelledby="search-heading">
      <h2 id="search-heading">寻诗</h2>
      <form class="search-form" id="search-form">
        <label class="sr-only" for="search-q">关键词</label>
        <input
          id="search-q"
          name="q"
          type="search"
          placeholder="输入诗句、标题或作者…"
          autocomplete="off"
          required
        />
        <button type="submit" class="btn-ink">搜索</button>
      </form>
      <p class="search-hint" id="search-status" role="status"></p>
      <ul class="search-results" id="search-results"></ul>
    </section>
  </main>

  <script>
    import '../scripts/search';
  </script>
</Layout>
