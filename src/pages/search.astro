---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<Layout title="诗泉 — 搜索">
  <SiteHeader />

  <main>
    <section class="search" aria-labelledby="search-heading">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        全文检索
      </p>
      <h2 class="search-heading" id="search-heading">寻诗</h2>
      <form class="search-bar" id="search-form">
        <label class="sr-only" for="search-q">关键词</label>
        <input
          id="search-q"
          name="q"
          type="search"
          placeholder="输入诗句、标题或作者…"
          autocomplete="off"
          required
        />
        <button type="submit" class="btn-ink">
          <span class="btn-label">搜索</span>
          <span class="btn-orb" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </span>
        </button>
      </form>
      <p class="search-hint" id="search-status" role="status"></p>
      <ul class="search-results" id="search-results"></ul>
    </section>
  </main>

  <script>
    import '../scripts/search';
  </script>
</Layout>
