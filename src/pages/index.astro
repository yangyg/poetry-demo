---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<Layout title="诗泉 — 首页">
  <div class="paper-grain" aria-hidden="true"></div>

  <SiteHeader />

  <main>
    <section class="reader" aria-labelledby="poem-title">
      <div class="reader-inner" id="reader">
        <p class="status" id="reader-status">正在取诗…</p>
        <h1 class="poem-title" id="poem-title" hidden></h1>
        <p class="poem-meta" id="poem-meta" hidden></p>
        <div class="poem-body" id="poem-body" hidden></div>
      </div>
      <div class="reader-actions">
        <button type="button" class="btn-ink" id="btn-random">换一首</button>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/reader';
  </script>
</Layout>
