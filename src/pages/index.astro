---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LayoutSwitch from '../components/LayoutSwitch.astro';
---
<Layout title="诗泉 — 首页">
  <SiteHeader />

  <main>
    <section class="stage" transition:name="poem-stage" aria-labelledby="poem-title">
      <div class="stage-side">
        <div>
          <p class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            诗泉 · 随机一叶
          </p>
          <h1 class="poem-title" id="poem-title" hidden></h1>
          <p class="poem-meta" id="poem-meta" hidden></p>
          <LayoutSwitch />
        </div>
        <div class="stage-actions">
          <button type="button" class="btn-ink" id="btn-random">
            <span class="btn-label">换一首</span>
            <span class="btn-orb" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
                <path d="M21 3v6h-6"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
      <div class="stage-reading">
        <div class="poem-body" id="poem-body" hidden></div>
      </div>
      <p class="status" id="reader-status">正在取诗…</p>
    </section>
  </main>

  <script>
    import '../scripts/reader';
  </script>
</Layout>
